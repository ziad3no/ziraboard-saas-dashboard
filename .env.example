# Copy to .env if you want to change these.
# Postgres connection string. Leave unset to use the local PGlite database in DATA_DIR.
# On Vercel, connecting Supabase sets POSTGRES_URL for you. Never commit a real URL: it contains a password.
DATABASE_URL=
# Port for `npm start`.
PORT=3001
# Port the API uses during `npm run dev` (Vite proxies /api to it).
API_PORT=3001
# Folder for the local PGlite database.
DATA_DIR=./data
# Show "Try a demo account" buttons on the login page (true/false).
DEMO_LOGIN=true
# Wipe and re-seed the demo data when it is older than N hours (0 = never; 24 by default on Vercel).
DEMO_RESET_HOURS=0
