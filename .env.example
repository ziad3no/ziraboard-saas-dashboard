# Copy to .env if you want to change these. None of them are secrets.
# Port in production (Render and most hosts set this for you).
PORT=3001
# Port the API uses during `npm run dev` (Vite proxies /api to it).
API_PORT=3001
# Folder for the SQLite database file.
DATA_DIR=./data
# Show "Try a demo account" buttons on the login page (true/false).
DEMO_LOGIN=true
# Wipe and re-seed the demo data every N hours (0 = never).
DEMO_RESET_HOURS=0
